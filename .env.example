# Local Docker Compose values. Replace every secret before using in shared or production environments.

POSTGRES_DB=pipelinepulse
POSTGRES_USER=pipelinepulse
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_HOST_PORT=5431

DATABASE_URL=postgresql+psycopg2://pipelinepulse:replace-with-local-db-password@db:5432/pipelinepulse

SECRET_KEY=replace-with-a-long-random-secret

# Optional backend settings.
FRONTEND_ORIGINS=http://localhost:8080
ENABLE_LIVE_PRICING=false
AWS_PRICING_BASE_URL=https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonEC2/current
AZURE_RETAIL_PRICES_URL=https://prices.azure.com/api/retail/prices
PRICING_CACHE_TTL_SECONDS=21600
CARBON_CACHE_TTL_SECONDS=86400
AUTO_CREATE_TABLES=true

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=http

# Optional container tuning.
BACKEND_PORT=5000
BACKEND_HOST_PORT=5000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# Frontend requires the backend upstream. Other frontend values are optional.
FRONTEND_API_BASE=/api
FRONTEND_BACKEND_UPSTREAM=http://backend:5000
FRONTEND_API_PROXY_PATH=/api/
FRONTEND_CONTAINER_PORT=80
FRONTEND_HOST_PORT=8080
PROXY_READ_TIMEOUT=60s
STATIC_CACHE_CONTROL=no-store, no-cache, must-revalidate, max-age=0
